{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "cloudflare.config.ts",
    "vite.config.ts",
    "worker/**/*.ts",
    ".cloudflare/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
